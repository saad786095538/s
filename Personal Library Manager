import streamlit as st
import json
import os

# File to store the library
LIBRARY_FILE = 'library_data.json'

# Initialize session state for the library
if 'library' not in st.session_state:
    st.session_state.library = []

# Load from file if available
def load_library():
    if os.path.exists(LIBRARY_FILE):
        with open(LIBRARY_FILE, 'r') as f:
            st.session_state.library = json.load(f)
        st.success("Library loaded successfully!")
    else:
        st.warning("No saved library file found.")

# Save
def save_library():
    with open(LIBRARY_FILE, 'w') as f:
        json.dump(st.session_state.library, f, indent=4)
    st.success("Library saved successfully!")

# Add
def add_book(book):
    st.session_state.library.append(book)
    st.success(f"Added '{book['title']}' to the library.")

# Remove
def remove_book(title):
    original_length = len(st.session_state.library)
    st.session_state.library = [
        book for book in st.session_state.library if book['title'].lower() != title.lower()
    ]
    if len(st.session_state.library) < original_length:
        st.success(f"Removed '{title}' from the library.")
    else:
        st.warning(f"No book titled '{title}' found.")

# Search
def search_books(query):
    query = query.lower()
    return [
        book for book in st.session_state.library
        if query in book['title'].lower() or
           query in book['author'].lower() or
           query in book['genre'].lower()
    ]

# Display statistics
def show_statistics():
    total = len(st.session_state.library)
    read = sum(1 for book in st.session_state.library if book['read'])
    unread = total - read
    genres = {}
    for book in st.session_state.library:
        genres[book['genre']] = genres.get(book['genre'], 0) + 1

    st.subheader("📊 Library Statistics")
    st.write(f"**Total books:** {total}")
    st.write(f"**Books read:** {read}")
    st.write(f"**Books unread:** {unread}")
    st.write("**Genres count:**")
    st.json(genres)

# Streamlit UI
st.title("📚 Personal Library Manager")

menu = st.sidebar.radio("Menu", ["Add Book", "Remove Book", "Search Books", "View All", "Statistics", "Save Library", "Load Library"])

if menu == "Add Book":
    st.header("➕ Add a New Book")
    with st.form("add_form"):
        title = st.text_input("Title", max_chars=100)
        author = st.text_input("Author", max_chars=100)
        year = st.number_input("Publication Year", min_value=0, max_value=2100, step=1)
        genre = st.text_input("Genre", max_chars=50)
        read = st.checkbox("Have you read it?")
        submitted = st.form_submit_button("Add Book")
        if submitted and title and author and genre:
            new_book = {
                "title": title,
                "author": author,
                "year": year,
                "genre": genre,
                "read": read
            }
            add_book(new_book)

elif menu == "Remove Book":
    st.header("🗑️ Remove a Book")
    title_to_remove = st.text_input("Enter the title of the book to remove")
    if st.button("Remove"):
        remove_book(title_to_remove)

elif menu == "Search Books":
    st.header("🔍 Search Your Library")
    search_query = st.text_input("Search by title, author, or genre")
    if search_query:
        results = search_books(search_query)
        if results:
            st.write(f"Found {len(results)} matching book(s):")
            for book in results:
                st.write(book)
        else:
            st.warning("No matching books found.")

elif menu == "View All":
    st.header("📖 All Books in Library")
    if st.session_state.library:
        for book in st.session_state.library:
            st.write(book)
    else:
        st.info("Your library is empty.")

elif menu == "Statistics":
    show_statistics()

elif menu == "Save Library":
    save_library()

elif menu == "Load Library":
    load_library()
